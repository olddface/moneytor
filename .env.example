PORT=3000
NODE_ENV=production

# mysql (default) or sqlite
DB_DRIVER=mysql

# Used when DB_DRIVER=mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=moneytor
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=moneytor

# Used when DB_DRIVER=sqlite. Created by npm run migrate if it does not exist.
# SQLITE_PATH=./data/moneytor.sqlite

DEFAULT_CURRENCY=IDR
MCP_SECRET_SLUG=replace-with-long-random-secret

# Optional app-level IP allowlist. Prefer enforcing this at Nginx/Caddy too.
# Include local addresses while testing from the VPS itself.
# ALLOWED_CIDRS=160.79.104.0/21,127.0.0.1/32
# TRUST_PROXY=true